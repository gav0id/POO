Ejercicio 1: Modelado básico e instanciación (Persona)
public class Persona {
    // Atributos de instancia
    String nombre;
    int edad;

    public static void main(String[] args) {
        // Instanciamos dos objetos distintos con 'new'
        Persona persona1 = new Persona();
        Persona persona2 = new Persona();

        // Asignamos valores directamente a los atributos de cada objeto
        persona1.nombre = "Lucía";
        persona1.edad = 21;

        persona2.nombre = "Mateo";
        persona2.edad = 23;

        // Imprimimos usando el operador de acceso punto (.)
        System.out.println("Persona 1: " + persona1.nombre + ", " + persona1.edad + " años");
        System.out.println("Persona 2: " + persona2.nombre + ", " + persona2.edad + " años");
    }
}
